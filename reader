<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Тест сканера штрихкодів</title>
  <script type="module">
    import { BrowserMultiFormatReader } from
      "https://cdn.jsdelivr.net/npm/@zxing/browser@0.1.5/+esm";

    const video = document.getElementById("video");
    const status = document.getElementById("status");
    const result = document.getElementById("result");
    const countLabel = document.getElementById("count");

    let reader = null;
    let controls = null;
    let count = 0;
    let lastCode = "";
    let lastTime = 0;

    window.startScanner = async function () {
      try {
        status.textContent = "Запускаємо камеру...";
        if (!reader) reader = new BrowserMultiFormatReader();

        controls = await reader.decodeFromVideoDevice(
          undefined,
          video,
          (scanResult, error) => {
            if (scanResult) {
              const code = scanResult.getText();
              const now = Date.now();

              // Захист від повторного зчитування того самого коду
              // протягом 1,5 секунди.
              if (code === lastCode && now - lastTime < 1500) return;

              lastCode = code;
              lastTime = now;
              count++;

              result.textContent = code;
              countLabel.textContent = count;
              status.textContent = "Штрихкод успішно розпізнано";
            }
          }
        );

        status.textContent = "Камера працює. Наведіть її на штрихкод.";
      } catch (error) {
        status.textContent = "Помилка камери: " + error.name +
          " — " + error.message;
      }
    };

    window.stopScanner = function () {
      if (controls) {
        controls.stop();
        controls = null;
      }
      if (video.srcObject) {
        video.srcObject.getTracks().forEach(track => track.stop());
        video.srcObject = null;
      }
      status.textContent = "Сканування зупинено";
    };
  </script>
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 20px;
      max-width: 600px;
      margin: auto;
      background: #f4f5f7;
    }
    h2 { text-align: center; }
    video {
      width: 100%;
      background: #111;
      border-radius: 12px;
      min-height: 220px;
    }
    button {
      width: 100%;
      padding: 16px;
      margin-top: 12px;
      font-size: 18px;
      border: 0;
      border-radius: 10px;
      color: white;
      background: #1677d2;
    }
    button.stop { background: #b83232; }
    .panel {
      background: white;
      padding: 16px;
      margin-top: 16px;
      border-radius: 10px;
      overflow-wrap: anywhere;
    }
  </style>
</head>
<body>
  <h2>Сканер штрихкодів</h2>

  <video id="video" autoplay muted playsinline></video>

  <button onclick="startScanner()">Увімкнути камеру</button>
  <button class="stop" onclick="stopScanner()">Зупинити камеру</button>

  <div class="panel">
    **Статус:** <span id="status">Очікування запуску</span>
  </div>
  <div class="panel">
    **Останній штрихкод:** <strong id="result">—</strong>
  </div>
  <div class="panel">
    **Кількість сканувань:** <strong id="count">0</strong>
  </div>
</body>
</html>
